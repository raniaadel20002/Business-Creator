{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data including preferences and basic info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID" },
        "displayName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "userData": { "type": "object", "description": "Saved answers from the questionnaire" },
        "subscriptionPlan": { 
          "type": "string", 
          "enum": ["FREE", "PRO"],
          "description": "Selected pricing plan: FREE, PRO (499 EGP)" 
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A generated business plan saved by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "ID of the user who owns this project" },
        "projectName": { "type": "string" },
        "concept": { "type": "string" },
        "type": { "type": "string" },
        "planData": { "type": "string", "description": "JSON stringified BusinessPlan object" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "projectName", "planData", "status", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in the advisor chat.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session with the AI advisor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "messages": { 
          "type": "array", 
          "items": { "$ref": "#/entities/ChatMessage" } 
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "messages", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Stores saved business plans."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Stores advisor chat sessions."
    }
  }
}
