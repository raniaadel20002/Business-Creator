# AI (Multi-Key Pool: Separate multiple keys with commas for automatic FIFO rotation and 2-min cooldown failover)
# IMPORTANT: Use GEMINI_API_KEY (server-side only), NOT VITE_GEMINI_API_KEY (would expose to browser)
GEMINI_API_KEY=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...

# App
APP_URL=https://businesscreator.app