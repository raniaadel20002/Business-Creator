rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "ashrafmena999@gmail.com";
    }
    
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }
    
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    
    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 100;
    }
    
    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.email is string && isValidEmail(data.email) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 500)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 5000)) &&
             (!('userData' in data) || data.userData is map) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100)) &&
             (!('subscriptionPlan' in data) || data.subscriptionPlan in ['FREE', 'PRO']) &&
             (!('tokens' in data) || data.tokens is number) &&
             (!('dailyGenerations' in data) || data.dailyGenerations is number) &&
             (!('lastGenerationDate' in data) || data.lastGenerationDate is string) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }
    
    function isValidProject(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
             data.projectName is string && data.projectName.size() > 0 && data.projectName.size() <= 1000 &&
             (!('concept' in data) || (data.concept is string && data.concept.size() <= 50000)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 500)) &&
             data.planData is string && data.planData.size() <= 1048576 &&
             data.status in ['active', 'inactive'] &&
             data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidChatSession(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.messages is list &&
             (!('title' in data) || (data.title is string && data.title.size() <= 1000)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && hasRequiredFields(['uid', 'email', 'createdAt']) && isValidUserProfile(request.resource.data) && uidUnchanged() && (!('subscriptionPlan' in request.resource.data) || request.resource.data.subscriptionPlan == 'FREE') && (!('tokens' in request.resource.data) || request.resource.data.tokens == 0);
      allow update: if (isOwner(userId) || isAdmin()) && 
                       isValidUserProfile(request.resource.data) && 
                       uidNotModified() && 
                       request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '') &&
                       (isAdmin() || 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'displayName', 'photoURL', 'userData', 
                          'dailyGenerations', 'lastGenerationDate', 'updatedAt'
                        ]));
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    match /projects/{projectId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && hasRequiredFields(['userId', 'projectName', 'planData', 'status', 'createdAt']) && isValidProject(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidProject(request.resource.data) && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /chats/{chatId} {
      allow get: if isAuthenticated() && (chatId.startsWith(request.auth.uid + "_") || isAdmin());
      allow list: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && hasRequiredFields(['userId', 'messages', 'createdAt']) && isValidChatSession(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidChatSession(request.resource.data) && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /ai_tasks/{taskId} {
      allow get, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isDocOwner();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
